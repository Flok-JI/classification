<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MDR Quiz: Classification of Medical Devices | Johner Institute</title>
    <!-- Scripts -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'DM Sans', sans-serif; background-color: #f7f9fc; }
        .johner-red { color: #cc0000; }
        .johner-bg-red { background-color: #cc0000; }
        .johner-btn-hover:hover { background-color: #aa0000; }
        .step { display: none; }
        .step.active { display: block; animation: fadeIn 0.4s ease-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
        .progress-bar { transition: width 0.5s ease-in-out; }
        
        .option-btn { cursor: pointer; text-align: center; padding: 1.15rem; border: 2px solid #f1f5f9; border-radius: 1rem; transition: all 0.2s; background: white; }
        .option-btn:hover { border-color: #cc0000; background-color: #fff5f5; }
        
        .coin-popup { animation: coinFloat 1s ease-out forwards; position: absolute; font-weight: bold; font-size: 1.5rem; pointer-events: none; z-index: 50; }
        @keyframes coinFloat { from { opacity: 1; transform: translateY(0); } to { opacity: 0; transform: translateY(-50px); } }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-center p-4 sm:p-5 pb-24">

    <div class="mb-8 sm:mb-10 text-center w-full max-w-2xl flex flex-col items-center">
        <div class="mb-5 sm:mb-6 flex items-center justify-center h-16 sm:h-20 w-full"> 
            <img src="Johner_Institute_GBA_Logo_RGB.png" alt="Johner Institute Logo" class="h-full object-contain">
        </div>
        <div class="h-px w-full bg-slate-200 mb-6 sm:mb-8"></div>
        <h1 class="text-2xl sm:text-3xl font-bold text-slate-800 uppercase tracking-tight">MDR Classification Quiz</h1>
        <p class="text-slate-500 mt-1 text-base sm:text-lg">Class I, IIa, IIb, or III? Test your knowledge according to Annex VIII!</p>
    </div>

    <div class="bg-white max-w-2xl w-full rounded-2xl shadow-xl overflow-hidden border border-slate-100 relative">
        <!-- Start Screen -->
        <div id="start-box" class="step active p-6 sm:p-10 text-center">
            <div class="mb-5 sm:mb-6 inline-block p-4 bg-slate-50 rounded-full border border-slate-100">
                <span class="text-4xl">🚀</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-800 mb-3 sm:mb-4">Welcome to the Quiz</h2>
            <p class="text-slate-500 mb-6 sm:mb-8">Please enter your name or team name to start:</p>
            <input type="text" id="teamNameInput" placeholder="Enter Name / Team Name..." 
                class="w-full p-3.5 sm:p-4 border-2 border-slate-200 rounded-xl mb-6 text-center text-lg focus:border-[#cc0000] outline-none transition-colors" autofocus>
            <button onclick="startQuiz()" class="johner-bg-red text-white px-8 sm:px-10 py-3.5 sm:py-4 rounded-xl font-bold johner-btn-hover transition-all w-full text-lg shadow-lg">
                Start Quiz
            </button>
        </div>

        <!-- Quiz Header (Progress & Score) -->
        <div id="quiz-header" class="hidden flex justify-between items-center px-6 sm:px-10 py-4 bg-slate-50 border-b border-slate-100">
            <div class="w-1/2 bg-slate-200 h-2 rounded-full overflow-hidden">
                <div id="progress" class="progress-bar h-full johner-bg-red" style="width: 0%;"></div>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-2xl">💰</span>
                <span id="scoreDisplay" class="text-xl font-bold text-slate-700">0</span>
            </div>
        </div>

        <div class="p-6 sm:p-10" id="quiz-container">
            <!-- Questions -->
            <div id="question-box" class="step">
                <span id="stepCounter" class="text-xs font-bold uppercase tracking-widest johner-red">Question 1 / 9</span>
                <h2 id="questionText" class="text-xl sm:text-2xl font-bold text-slate-800 mt-2 mb-4 leading-snug">...</h2>
                
                <!-- Intended Purpose Box -->
                <div class="bg-slate-50 border border-slate-200 rounded-xl p-4 mb-6 sm:mb-8 text-left">
                    <span class="block text-xs font-bold uppercase tracking-wider text-slate-400 mb-1">Intended Purpose</span>
                    <p id="intendedPurposeText" class="text-sm sm:text-base text-slate-700 leading-relaxed">...</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 sm:gap-4">
                    <button onclick="handleAnswer('Class I')" class="option-btn">
                        <span class="block text-lg font-bold text-slate-800">Class I</span>
                        <span class="block text-xs text-slate-400 mt-0.5">Low risk (incl. Is / Im / Ir)</span>
                    </button>
                    <button onclick="handleAnswer('Class IIa')" class="option-btn">
                        <span class="block text-lg font-bold text-slate-800">Class IIa</span>
                        <span class="block text-xs text-slate-400 mt-0.5">Low to medium risk</span>
                    </button>
                    <button onclick="handleAnswer('Class IIb')" class="option-btn">
                        <span class="block text-lg font-bold text-slate-800">Class IIb</span>
                        <span class="block text-xs text-slate-400 mt-0.5">Medium to high risk</span>
                    </button>
                    <button onclick="handleAnswer('Class III')" class="option-btn">
                        <span class="block text-lg font-bold text-slate-800">Class III</span>
                        <span class="block text-xs text-slate-400 mt-0.5">High risk</span>
                    </button>
                </div>
            </div>

            <!-- Feedback -->
            <div id="feedback-box" class="step text-center">
                <div id="feedbackIcon" class="mb-5 sm:mb-6 inline-block p-4 rounded-full border"></div>
                <h2 id="feedbackTitle" class="text-2xl font-bold text-slate-800 mb-4">Feedback</h2>
                <div id="feedbackText" class="p-5 sm:p-6 rounded-xl italic text-base sm:text-lg text-slate-700 mb-6 sm:mb-8 border border-slate-200 text-left leading-relaxed">
                    Explanation goes here...
                </div>
                <button onclick="showNextQuestion()" class="johner-bg-red text-white px-8 sm:px-10 py-3.5 rounded-xl font-bold johner-btn-hover transition-all shadow-md text-lg w-full">
                    Next Question →
                </button>
            </div>

            <!-- Result -->
            <div id="result" class="step text-center">
                <div class="mb-5 sm:mb-6 inline-block p-4 bg-yellow-50 rounded-full border border-yellow-100">
                    <span class="text-5xl">🏆</span>
                </div>
                <h2 class="text-2xl sm:text-3xl font-bold text-slate-800 mb-2">Quiz Completed!</h2>
                <p class="text-slate-500 text-base sm:text-lg mb-2">Team: <span id="finalTeamName" class="font-bold text-slate-800"></span></p>
                <p class="text-slate-500 text-base sm:text-lg mb-6">Your final score:</p>
                
                <div class="inline-block px-10 py-5 sm:py-6 bg-slate-800 rounded-3xl mb-6 sm:mb-8">
                    <div class="flex items-center gap-4">
                        <span class="text-4xl">💰</span>
                        <span id="finalScore" class="text-4xl sm:text-5xl font-black text-white">0</span>
                    </div>
                </div>

                <div id="saveStatus" class="text-sm mb-6 text-slate-400 italic">Saving to cloud...</div>

                <p class="text-slate-500 text-xs sm:text-sm mb-8 sm:mb-10 px-2 sm:px-4">
                    This quiz is a learning tool. The risk class is determined by the <strong>MDR classification rules (Annex VIII)</strong> based on the manufacturer's intended purpose.
                </p>

                <button onclick="location.reload()" class="johner-bg-red text-white px-8 sm:px-10 py-3.5 rounded-xl font-bold johner-btn-hover transition-all shadow-md text-lg w-full">
                    Restart Quiz
                </button>
            </div>
        </div>
    </div>

    <footer class="fixed bottom-0 left-0 w-full p-3 sm:p-4 bg-slate-50 border-t border-slate-200 text-center text-slate-400 text-xs italic">
        Property of Johner Institute GmbH.
    </footer>

    <script>
        // Supabase Init
        const SUPABASE_URL = 'https://icuwbibmhlqpmfgvjibp.supabase.co'; 
        const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImljdXdiaWJtaGxxcG1mZ3ZqaWJwIiwicm9sZSI6ImFub24iLCJpYXQiOjE3Nzc0OTk1NDEsImV4cCI6MjA5MzA3NTU0MX0.8Yo8ueUcOEZt_ZEbIj_OvwCTQ2O3aOfhYxPWT1rq-OI'; 
        const supabaseClient = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);

        const questions = [
            { 
                text: "Reusable surgical scalpel", 
                purpose: "Manual cutting of tissue during surgical procedures; reused after reprocessing (cleaning and sterilization).",
                correctClass: "Class I", 
                explanation: "<strong>Class I (Ir) – Rule 6:</strong> Surgically invasive devices intended for transient use are generally Class IIa, unless they are reusable surgical instruments – these fall into Class I (requiring Notified Body involvement for reprocessing aspects, Ir)." 
            },
            { 
                text: "Radiotherapy dose calculation software", 
                purpose: "Calculation and determination of the exact radiation dose for treating cancer patients on a linear accelerator.",
                correctClass: "Class IIb", 
                explanation: "<strong>Class IIb – Rule 11:</strong> Software intended to provide information used to take decisions with diagnosis or therapeutic purposes is Class IIa – unless such decisions have an impact that may cause a serious deterioration of a person's state of health or a surgical intervention (in which case it is Class IIb)." 
            },
            { 
                text: "Digital electronic clinical thermometer", 
                purpose: "Measurement of human body temperature to detect fever in patients.",
                correctClass: "Class IIa", 
                explanation: "<strong>Class IIa – Rule 10:</strong> Active devices intended for diagnosis and monitoring of vital physiological parameters (such as body temperature, blood pressure, or heart rate) are classified as Class IIa." 
            },
            { 
                text: "Coronary drug-eluting stent (DES)", 
                purpose: "Permanent implantation into narrowed coronary arteries to keep the vessel open and locally release a medicinal substance to prevent restenosis.",
                correctClass: "Class III", 
                explanation: "<strong>Class III – Rule 8 & Rule 14:</strong> Implantable devices intended to be used in direct contact with the heart or central circulatory system (as well as devices incorporating a medicinal substance) fall into the highest risk class, Class III." 
            },
            { 
                text: "Non-sterile adhesive bandage for superficial skin wounds", 
                purpose: "Covering and protecting minor, superficial cuts and abrasions of intact or slightly injured skin.",
                correctClass: "Class I", 
                explanation: "<strong>Class I – Rule 1 & Rule 4:</strong> Non-invasive devices intended only to act as a mechanical barrier, for compression, or for absorption of exudates are classified as Class I." 
            },
            { 
                text: "Infusion pump for intravenous drug administration", 
                purpose: "Controlled, continuous administration of liquid medications and infusion solutions into a patient's vascular system.",
                correctClass: "Class IIb", 
                explanation: "<strong>Class IIb – Rule 12:</strong> Active devices intended to administer medicinal products or other substances to the body are Class IIa – however, if this is done in a manner that is potentially hazardous taking account of the nature of the substances and the mode of application (e.g., IV infusion pump), Class IIb applies." 
            },
            { 
                text: "Software app for documenting and trend analysis of migraine diaries", 
                purpose: "Recording headache episodes and triggers to support physicians in diagnosing migraine and adjusting therapy.",
                correctClass: "Class IIa", 
                explanation: "<strong>Class IIa – Rule 11:</strong> Software intended to provide information which is used to take decisions with diagnosis or therapeutic purposes is classified as at least Class IIa under Rule 11 (provided no life-threatening or serious deterioration consequences apply)." 
            },
            { 
                text: "Absorbable surgical suture (internal wound closure)", 
                purpose: "Closure of internal soft tissue during surgery; completely degraded (absorbed) by the body within 60 days.",
                correctClass: "Class III", 
                explanation: "<strong>Class III – Rule 8:</strong> Implantable devices and long-term surgically invasive devices are Class IIb, but are classified as Class III if they have a biological effect or are wholly or mainly absorbed." 
            },
            { 
                text: "Sterile single-use hypodermic syringe (without needle)", 
                purpose: "Drawing up and administering fluids or medications in conjunction with a separate needle or infusion system.",
                correctClass: "Class I", 
                explanation: "<strong>Class I (Is) – Rule 2:</strong> Non-invasive devices intended for channelling or storing liquids for eventual infusion into the body are Class I (since placed on the market in sterile condition: Class Is, requiring Notified Body involvement for sterility)." 
            }
        ];

        let currentQ = 0;
        let score = 0;
        let teamName = "";

        document.getElementById('teamNameInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                startQuiz();
            }
        });

        function startQuiz() {
            teamName = document.getElementById('teamNameInput').value.trim();
            if (teamName.length < 2) { alert("Please enter a name (at least 2 characters)!"); return; }

            document.getElementById('start-box').classList.remove('active');
            document.getElementById('question-box').classList.add('active');
            document.getElementById('quiz-header').classList.remove('hidden');
            
            loadQuestion();
        }

        function loadQuestion() {
            document.getElementById('stepCounter').innerText = `Question ${currentQ + 1} / ${questions.length}`;
            document.getElementById('questionText').innerText = questions[currentQ].text;
            document.getElementById('intendedPurposeText').innerText = questions[currentQ].purpose;
            updateProgress();
        }

        function updateProgress() {
            const percent = (currentQ / questions.length) * 100;
            document.getElementById('progress').style.width = percent + '%';
        }

        function handleAnswer(userAnswer) {
            const q = questions[currentQ];
            const isCorrect = (userAnswer === q.correctClass);
            
            // Score & Coin Effect
            const points = isCorrect ? 100 : -50;
            score += points;
            document.getElementById('scoreDisplay').innerText = score;

            const coin = document.createElement('div');
            coin.className = 'coin-popup';
            coin.innerText = isCorrect ? '+100 💰' : '-50 💸';
            coin.style.left = '50%'; coin.style.top = '40%';
            coin.style.color = isCorrect ? '#22c55e' : '#ef4444';
            document.getElementById('quiz-container').appendChild(coin);
            setTimeout(() => coin.remove(), 1000);

            // Feedback screen
            document.getElementById('question-box').classList.remove('active');
            document.getElementById('feedback-box').classList.add('active');

            const icon = document.getElementById('feedbackIcon');
            const title = document.getElementById('feedbackTitle');
            const feedbackText = document.getElementById('feedbackText');

            if(isCorrect) {
                title.innerText = `Correct! (${q.correctClass})`;
                title.className = "text-2xl font-bold text-green-600 mb-4";
                icon.innerHTML = '✅';
                icon.className = "mb-5 sm:mb-6 inline-block p-4 rounded-full border border-green-200 bg-green-50 text-3xl";
                feedbackText.className = "p-5 sm:p-6 bg-green-50 rounded-xl italic text-base sm:text-lg text-slate-700 mb-6 sm:mb-8 border border-green-200 text-left leading-relaxed";
            } else {
                title.innerText = `Incorrect – Correct answer: ${q.correctClass}`;
                title.className = "text-2xl font-bold text-red-600 mb-4";
                icon.innerHTML = '❌';
                icon.className = "mb-5 sm:mb-6 inline-block p-4 rounded-full border border-red-200 bg-red-50 text-3xl";
                feedbackText.className = "p-5 sm:p-6 bg-red-50 rounded-xl italic text-base sm:text-lg text-slate-700 mb-6 sm:mb-8 border border-red-200 text-left leading-relaxed";
            }
            feedbackText.innerHTML = q.explanation;
        }

        function showNextQuestion() {
            currentQ++;
            if(currentQ < questions.length) {
                document.getElementById('feedback-box').classList.remove('active');
                document.getElementById('question-box').classList.add('active');
                loadQuestion();
            } else {
                showResult();
            }
        }

        async function showResult() {
            document.getElementById('feedback-box').classList.remove('active');
            document.getElementById('result').classList.add('active');
            document.getElementById('finalScore').innerText = score;
            document.getElementById('finalTeamName').innerText = teamName;
            document.getElementById('progress').style.width = '100%';

            try {
                const { error } = await supabaseClient
                    .from('classification')
                    .insert([{ team: teamName, score: score }]);

                if (error) throw error;
                document.getElementById('saveStatus').innerText = "Score saved successfully! ✅";
                document.getElementById('saveStatus').className = "text-sm mb-6 text-green-500 font-bold";
            } catch (err) {
                console.error(err);
                document.getElementById('saveStatus').innerText = "Error saving score. Please check API Key & RLS.";
                document.getElementById('saveStatus').className = "text-sm mb-6 text-red-500 font-bold";
            }
        }
    </script>
</body>
</html>
